# =========================================
# Inventory Management System — Environment
# =========================================
# Copy this file to .env and fill in values

# ── Database ──────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=inventory_management_system
MYSQL_USER=ims_user
MYSQL_PASSWORD=change_me_db_password

# ── JWT ───────────────────────────────────
# Use a long random string (min 64 chars)
JWT_SECRET=generate-a-secure-64-character-minimum-secret-key-here
JWT_EXPIRATION_MS=86400000

# ── Email Notifications (optional) ────────
NOTIFICATIONS_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
NOTIFICATIONS_ADMIN_EMAIL=admin@yourcompany.com
